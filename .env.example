# ========================================================
# SPARK / شرارة V2.0 — Environment Configuration Example
# ========================================================

# 1. Application URL (Optional for Production / Custom Domains)
# If empty, SPARK automatically detects runtime origin and LAN IP in local dev.
# NEXT_PUBLIC_APP_URL=https://spark-ar.vercel.app

# 2. Dedicated Firebase Realtime Database Configuration (Isolated from Supabase)
# Obtain these from your dedicated Firebase Project Console -> Project Settings -> General
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKey123456789
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=spark-live-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://spark-live-app-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=spark-live-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=spark-live-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
